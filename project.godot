; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WhiteHat"
config/description="An accessible, frustration-free investigation game packed with tough moral dilemmas. Solve missions with escalating consequences against a relentless AI through a sleek interface. A multi-faceted story full of secrets, forged by my experience as a creator."
config/version="1.0"
run/main_scene="res://main_menu.tscn"
config/custom_user_dir_name="whitehat"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="uid://biveoehljcb8l"
config/windows_native_icon="uid://biveoehljcb8l"

[audio]

buses/default_bus_layout="res://audio/bus_layout.tres"

[autoload]

Settings="*res://autoloads/settings.gd"
PlayerSession="*res://autoloads/player_session.gd"
MusicPlayer="*res://autoloads/music_player.gd"
SfxPlayer="*res://autoloads/sfx_player.gd"
SaveManager="*res://autoloads/save_manager.gd"
SceneTransition="*res://autoloads/scene_transition.gd"
OptionsMenu="*res://autoloads/options_menu.gd"
GameClock="*res://autoloads/game_clock.gd"
StoryVars="*res://autoloads/story_vars.gd"
ClueManager="*res://autoloads/clue_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom="res://themes/main_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.fr.translation", "res://translations/ui.en.translation", "res://translations/indices.fr.translation", "res://translations/indices.en.translation", "res://translations/dialogue.fr.translation", "res://translations/dialogue.en.translation")
locale/translations_pot_files=PackedStringArray("res://dialogue/intro.dialogue", "res://dialogue/relayghost_intro.dialogue", "res://dialogue/jean_intro.dialogue", "res://dialogue/relayghost_help.dialogue", "res://dialogue/relayghost_report_m1.dialogue", "res://dialogue/jean_report_m1.dialogue", "res://dialogue/relayghost_mission2_intro.dialogue")
locale/include_text_server_data=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.016, 0.043, 0.031, 1)
anti_aliasing/quality/screen_space_aa=1
